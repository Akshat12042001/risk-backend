{
  "name": "risk-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "$HOME/mongodb/bin/mongod --dbpath $HOME/mongodb/data --bind_ip 127.0.0.1 --port 27017 --fork --logpath $HOME/mongodb/mongod.log",
    "db:stop": "$HOME/mongodb/bin/mongod --dbpath $HOME/mongodb/data --shutdown",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.1",
    "zod": "^3.25.76"
  }
}
